{
    "name": "storefront-child-theme",
    "version": "1.2.7",
    "private": true,
    "devDependencies": {
        "@types/node": "^25.9.2",
        "esbuild": "^0.28.1",
        "sass": "^1.80.0",
        "typescript": "^6.0.3"
    },
    "scripts": {
        "build:css": "sass --style=compressed style.scss style.css",
        "watch:css": "sass --watch style.scss:style.css",
        "watch:ts": "npx esbuild assets/ts/app.ts assets/ts/compareContents.ts --bundle --outdir=assets/js --watch",
        "build:ts": "npx esbuild assets/ts/app.ts assets/ts/compareContents.ts --bundle --outdir=assets/js --minify",
        "dev": "npm run watch:css & npm run watch:ts",
        "build": "npm run build:css && npm run build:ts && node extract.ts"
    }
}